rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMatchParticipant(matchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    match /usuarios/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);

      match /fcmTokens/{token} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /notificaciones/{notificacionId} {
      allow read: if signedIn()
        && (resource.data.uidDestino == request.auth.uid
          || resource.data.uidOrigen == request.auth.uid);

      allow create: if signedIn()
        && (request.resource.data.uidDestino == request.auth.uid
          || request.resource.data.uidOrigen == request.auth.uid);

      allow update: if signedIn()
        && resource.data.uidDestino == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['leida', 'leidaEn']);

      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.users;

      match /mensajes/{mensajeId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.from == request.auth.uid;
        allow update: if isMatchParticipant(matchId);
        allow delete: if isMatchParticipant(matchId);
      }
    }

    match /likes/{uid}/dados/{otroUid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /bloqueos/{uid}/usuarios/{otroUid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /reportes/{reporteId} {
      allow create: if signedIn() && request.resource.data.reportador == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
